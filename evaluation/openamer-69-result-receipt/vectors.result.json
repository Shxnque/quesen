        "admissibility": false
      },
      "expected": "REJECT",
      "match": true
    },
    {
      "id": "R6-budget-admissibility",
      "description": "Valid+reproducible receipt whose units_consumed (8) exceeds the bounded grant budget (5) \u2014 the advertised-but-unenforced budget made to bite at the receipt.",
      "verdict": "REJECT",
      "checks": {
        "signature": true,
        "freshness": true,
        "binding": true,
        "reproducibility": true,
        "admissibility": false
      },
      "expected": "REJECT",
