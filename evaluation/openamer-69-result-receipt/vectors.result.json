      "verdict": "REJECT",
      "checks": {
        "signature": true,
        "freshness": true,
        "binding": true,
        "reproducibility": false,
        "admissibility": true
      },
      "expected": "REJECT",
      "match": true
    },
    {
      "id": "R4-freshness",
      "description": "Signed receipt replayed outside the 300s freshness window.",
      "verdict": "REJECT",
      "checks": {
        "signature": true,
        "freshness": false,
        "binding": true,
        "reproducibility": true,
        "admissibility": true
      },
      "expected": "REJECT",
      "match": true
    },
    {
      "id": "R5-signature",
