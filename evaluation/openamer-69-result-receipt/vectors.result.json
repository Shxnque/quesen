      "expected": "ACCEPT",
      "match": true
    },
    {
      "id": "R2-binding",
      "description": "Receipt task_id != the nonce A requested (a receipt for someone else's task).",
      "verdict": "REJECT",
      "checks": {
        "signature": true,
        "freshness": true,
        "binding": false,
        "reproducibility": true,
        "admissibility": true
      },
      "expected": "REJECT",
      "match": true
    },
    {
      "id": "R3-reproducibility",
